# ================================
# POS System SaaS - Root .gitignore
# ================================

# Environment files and secrets
.env
.env.*
!.env.example
!.env.*.example
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Private keys and certificates
*.pem
*.key
id_rsa
id_ed25519
**/id_rsa
**/id_ed25519
**/Enter passphrase (empty for no passphrase):*

# Java / Maven
**/target/
**/bin/
**/build/
**/out/
*.class
*.jar
*.war
*.ear
.mvn/timing.properties

# Node / Vite
**/node_modules/
**/dist/
**/dist-ssr/
**/.vite/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Test / coverage output
coverage/
.nyc_output/

# IDEs and editors
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/extensions.json
.project
.classpath
.settings/
*.swp
*.swo

# macOS / Windows
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Desktop.ini

# Logs and temporary files
*.log
logs/
*.tmp
*.temp
*~
